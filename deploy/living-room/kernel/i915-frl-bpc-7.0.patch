 static enum drm_mode_status
+intel_dp_hdmi_clock_valid(struct intel_dp *intel_dp,
+			  int clock, int bpc,
+			  enum intel_output_format sink_format,
+			  bool respect_downstream_limits)
+{
+	int max_frl_bw;
+
+	if (!respect_downstream_limits)
+		return MODE_OK;
+
+	max_frl_bw = min(intel_dp->dfp.pcon_max_frl_bw,
+			 intel_dp_hdmi_sink_max_frl(intel_dp));
+
+	/* FRL is not constrained by the HDMI TMDS character clock. */
+	if (max_frl_bw > 0) {
+		if (sink_format == INTEL_OUTPUT_FORMAT_YCBCR420)
+			clock /= 2;
+
+		if (clock * bpc * 3 > max_frl_bw * 1000000)
+			return MODE_CLOCK_HIGH;
+
+		return MODE_OK;
+	}
+
+	return intel_dp_tmds_clock_valid(intel_dp, clock, bpc,
+					 sink_format, respect_downstream_limits);
+}
