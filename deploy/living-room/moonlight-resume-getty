#!/bin/sh
# systemd-sleep calls this after the kernel has resumed, even if Moonlight
# remained alive but its streaming session was disconnected by suspend.
if [ "$1" = post ]; then
    /usr/bin/logger -t moonlight-resume "post-suspend hook: queueing immediate getty restart"
    /usr/bin/systemctl start --no-block moonlight-resume-getty.service
fi
